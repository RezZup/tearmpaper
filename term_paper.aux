\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Our experiment: macro-F1 on PROMISE NFR, mean $\pm $ SD over seeds 42–44 of pooled out-of-fold predictions. Random = stratified 10-fold; project = project-held-out 5-fold. Task A: FR vs. NFR (n = 625); Task B: US/SE/O/PE (n = 249). NB = multinomial Naive Bayes; DistilBERT has 2 of 6 blocks frozen. $^{\dagger }$ One seed (42). Best mean per column in bold. Accuracies are in the reproducibility package.}}{7}{table.3}\protected@file@percent }
\newlabel{tab:res}{{III}{7}{Our experiment: macro-F1 on PROMISE NFR, mean $\pm $ SD over seeds 42–44 of pooled out-of-fold predictions. Random = stratified 10-fold; project = project-held-out 5-fold. Task A: FR vs. NFR (n = 625); Task B: US/SE/O/PE (n = 249). NB = multinomial Naive Bayes; DistilBERT has 2 of 6 blocks frozen. $^{\dagger }$ One seed (42). Best mean per column in bold. Accuracies are in the reproducibility package}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Our experiment: exact McNemar tests of DistilBERT against each baseline on project-held-out folds (pooled out-of-fold predictions of one seed). In all 18 comparisons DistilBERT was right on more of the discordant items. The Bonferroni column multiplies each p-value by three, for the three baselines compared per task and seed. The tests assume independent items (see Section~\ref {sec:threats}).}}{7}{table.4}\protected@file@percent }
\newlabel{tab:mcn}{{IV}{7}{Our experiment: exact McNemar tests of DistilBERT against each baseline on project-held-out folds (pooled out-of-fold predictions of one seed). In all 18 comparisons DistilBERT was right on more of the discordant items. The Bonferroni column multiplies each p-value by three, for the three baselines compared per task and seed. The tests assume independent items (see Section~\ref {sec:threats})}{table.4}{}}
