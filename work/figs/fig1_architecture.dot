digraph G {
  graph [rankdir=TB, fontname="Times-Roman", fontsize=11, nodesep=0.22, ranksep=0.24, pad=0.06, dpi=300, newrank=true];
  node  [shape=box, style="rounded,filled", fontname="Times-Roman", fontsize=11, fillcolor="#EEF3FA", color="#3A5A80", penwidth=1.0, margin="0.07,0.04"];
  edge  [color="#3A5A80", arrowsize=0.6, penwidth=0.9, fontname="Times-Roman", fontsize=10];
  jira [label="Issue-tracker items\n(Jira, Azure Boards)"];
  us   [label="User stories +\nacceptance criteria"];
  fb   [label="Stakeholder notes,\nfeedback"];
  pre  [label="Pre-processing: template parsing (role / goal / benefit),\nsplit story vs. criteria, normalise, de-identify", width=3.6];
  enc  [label="Fine-tuned BERT-family encoder  ->  [CLS] vector", fillcolor="#D6E4F5", width=3.6];
  h1   [label="Level-1 head\nFR vs. NFR"];
  h2   [label="Level-2 head\nNFR subtype"];
  gate [label="p_max >= tau ?", shape=diamond, style="filled", fillcolor="#FFF6DD", color="#9C7A1E", margin="0.02,0.02"];
  hum  [label="Human review queue\n(PO / team)", fillcolor="#FBE9E7", color="#A04030"];
  auto [label="Auto-label\n(suggested tag)", fillcolor="#E5F2E5", color="#3C7A3C"];
  pb   [label="Product backlog: labels,\nNFR checklist, Definition of Done", fillcolor="#D6E4F5"];
  store[label="Versioned\ncorrections", shape=cylinder, fillcolor="#F2F2F2", color="#555555"];
  {rank=same; jira; us; fb;}
  {rank=same; h1; h2;}
  {rank=same; hum; gate; auto;}
  {rank=same; jira; us; fb;}
  {rank=same; pb; store;}
  {jira us fb} -> pre -> enc;
  enc -> h1;
  enc -> h2 [style=invis];
  h1 -> h2 [label=" if NFR"];
  h1 -> gate; h2 -> gate;
  hum -> gate [dir=back, label="no"];
  gate -> auto [label="yes"];
  hum -> pb; auto -> pb;
  pb -> store [label=" accept /\n correct", style=dashed];
  node [shape=point, width=0.01, height=0.01, label="", style=invis];
  r1; r2; r3;
  {rank=same; enc; r1;}
  {rank=same; h2; r2;}
  {rank=same; auto; r3;}
  h2 -> r2 [style=invis]; auto -> r3 [style=invis];
  store:e -> r3 [style=dashed, dir=none, tailport=e];
  r3 -> r2 [style=dashed, dir=none, label=" re-train"];
  r2 -> r1 [style=dashed, dir=none];
  r1 -> enc [style=dashed, constraint=false];
}
