digraph G {
  graph [rankdir=TB, fontname="Times-Roman", fontsize=10, nodesep=0.18, ranksep=0.17, pad=0.06, dpi=300];
  node  [shape=box, style="rounded,filled", fontname="Times-Roman", fontsize=10, fillcolor="#EEF3FA", color="#3A5A80", margin="0.08,0.03", width=2.7];
  edge  [color="#3A5A80", arrowsize=0.6, penwidth=0.9];
  inp  [label="Raw item: \"As a user, I want to reset\nmy password via an e-mailed link\nso that I can regain access.\"", fillcolor="#FFFFFF"];
  tok  [label="WordPiece tokens, max length L = 64\n[CLS] as a user , i want ... [SEP]"];
  emb  [label="Token + position embeddings\n(frozen in our run)", fillcolor="#E6E6E6", color="#666666"];
  low  [label="Transformer blocks 1-2 (frozen)", fillcolor="#E6E6E6", color="#666666"];
  up   [label="Transformer blocks 3-6 (updated)", fillcolor="#D6E4F5"];
  cls  [label="h[CLS] -> pre-classifier\n-> dropout -> linear layer"];
  sm   [label="softmax over K labels: p(y | x)"];
  loss [label="Class-weighted\ncross-entropy (Eq. 1),\nAdamW, warm-up/decay", fillcolor="#FFF6DD", color="#9C7A1E", width=1.45];
  out  [label="Label + confidence\np_max, passed to the\nconfidence gate", fillcolor="#E5F2E5", color="#3C7A3C", width=1.45];
  inp -> tok -> emb -> low -> up -> cls -> sm;
  sm -> out;
  {rank=same; loss; out;}
  sm -> loss [label=" training", fontname="Times-Roman", fontsize=9, style=dashed];
  node [shape=point, width=0.01, height=0.01, label="", style=invis];
  w1; w2;
  {rank=same; w1; up;}
  {rank=same; w2; cls;}
  w1 -> up [style=invis]; w2 -> cls [style=invis];
  loss:w -> w2 [style=dashed, dir=none];
  w2 -> w1 [style=dashed, dir=none, xlabel="back-prop ", fontname="Times-Roman", fontsize=9];
  w1 -> up:w [style=dashed, constraint=false];
}
